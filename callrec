# ---------- helpers ----------

def die(msg: str) -> None:
    print(f"✖ {msg}", file=sys.stderr)
    sys.exit(1)


def need(tool: str) -> str:
    path = shutil.which(tool)
    if not path:
        die(f"'{tool}' not found. Run the CallRec installer (see README) or setup.sh.")
    return path


def whisper_bin() -> str:
    for name in ("whisper-cli", "whisper-cpp"):
        if shutil.which(name):
            return name
    die("whisper.cpp not found. Run the CallRec installer (see README) or setup.sh.")
    return ""


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=True, **kw)


def ff(*args: str) -> None:
    run(["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", *args])


def probe(path: Path) -> tuple[float, int]:
    out = run(["ffprobe", "-v", "error", "-show_entries", "stream=channels:format=duration",
               "-of", "json", str(path)], capture_output=True, text=True).stdout
    data = json.loads(out)
    duration = float(data.get("format", {}).get("duration", 0) or 0)
    streams = data.get("streams") or [{}]
    return duration, int(streams[0].get("channels", 1) or 1)


def slug(text: str) -> str:
    return re.sub(r"[^\w\-]+", "-", text, flags=re.UNICODE).strip("-")[:40]


def has_call(folder: Path) -> bool:
    return (folder / "call.wav").exists() or (folder / "call.m4a").exists()


def call_file(folder: Path) -> Path | None:
    # call.wav is removed only after call.m4a is checked to be complete, so while both exist
    # the WAV is the full recording and the m4a may be a cut-off leftover.
    for name in ("call.wav", "call.m4a"):
        if (folder / name).exists():
            return folder / name
    return None


def has_audio(path: Path) -> bool:
    return path.exists() and path.stat().st_size > 1024


def fmt_dur(seconds: float) -> str:
    s = int(seconds)
    return f"{s // 3600}:{s % 3600 // 60:02d}:{s % 60:02d}" if s >= 3600 else f"{s // 60}:{s % 60:02d}"


DISCREET = HOME / ".callrec/discreet"  # exists = no pop-ups (screen sharing)


def notify(text: str) -> None:
    if EVENTS or DISCREET.exists():  # the app is always discreet: no pop-ups during or after calls
        return
    text = text.replace('"', "'")
    subprocess.run(["osascript", "-e", f'display notification "{text}" with title "callrec"'],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def read_meta(folder: Path) -> dict:
    try:
        return json.loads((folder / "meta.json").read_text())
    except (OSError, ValueError):
        return {}


def write_meta(folder: Path, **fields) -> dict:
    meta = read_meta(folder) | fields
    (folder / "meta.json").write_text(json.dumps(meta, ensure_ascii=False, indent=2))
    return meta


# ---------- meeting detection ----------

def call_apps() -> tuple[set[str], set[str]]:
    """(call apps using the mic, call apps using the mic or playing audio) right now."""
    from catap import list_audio_processes

    using_mic, active = set(), set()
    for p in list_audio_processes():
        bundle = p.bundle_id or ""
        name = next((n for prefix, n in MEETING_APPS.items() if bundle.startswith(prefix)), None)
        if not name:
            continue
        if p.is_inputting:
            using_mic.add(name)
        if p.is_inputting or p.is_outputting:
            active.add(name)
    return using_mic, active


def audio_devices() -> tuple[str | None, str | None]:
    """Names of the current default mic and output (headphones or speakers)."""
    try:
        from catap import list_audio_devices

        devs = list_audio_devices()
        mic = next((d.name for d in devs if d.is_default_input), None)
        out = next((d.name for d in devs if d.is_default_output), None)
        return mic, out
    except Exception:
        return None, None


def meeting_app(include_output: bool = False) -> str | None:
    """Name of a meeting app that is using the mic right now (or playing audio, if include_output)."""
    from catap import list_audio_processes

    for p in list_audio_processes():
        if not (p.is_inputting or (include_output and p.is_outputting)):
            continue
        bundle = p.bundle_id or ""
        for prefix, name in MEETING_APPS.items():
            if bundle.startswith(prefix):
                return name
    return None


# ---------- terminal / signals ----------

class Hangup(Exception):
    """The terminal closed (SIGHUP) or someone sent SIGTERM."""


def _on_hangup(signum, frame) -> None:
    # Once is enough: a repeat signal while we are already saving must not interrupt the save.
    signal.signal(signal.SIGHUP, signal.SIG_IGN)
    signal.signal(signal.SIGTERM, signal.SIG_IGN)
    raise Hangup()


def terminal_alive() -> bool:
    try:
        os.close(os.open("/dev/tty", os.O_RDWR))
        return True
    except OSError:
        return False


def detach_output(log_path: Path) -> None:
    """The terminal is gone: send our output (and our children's) to a log file."""
    log = os.open(log_path, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o644)
    os.dup2(os.open(os.devnull, os.O_RDONLY), 0)
    os.dup2(log, 1)
    os.dup2(log, 2)
    sys.stdout = os.fdopen(1, "w", buffering=1, encoding="utf-8", closefd=False)
    sys.stderr = os.fdopen(2, "w", buffering=1, encoding="utf-8", closefd=False)


def enter_pressed() -> bool:
    """Non-blocking check for Enter. Raises Hangup if the terminal went away."""
    try:
        if not sys.stdin.isatty():
            return False  # run by the app or from a script: only signals stop us
        ready, _, _ = select.select([sys.stdin], [], [], 0)
        if not ready:
            return False
        if sys.stdin.readline() == "" and not terminal_alive():
            raise Hangup()
        return True
    except (OSError, ValueError):
        if not terminal_alive():
            raise Hangup()
        return False


def status(line: str) -> None:
    try:
        if sys.stdout.isatty():
            sys.stdout.write("\r\033[K" + line)
            sys.stdout.flush()
    except OSError:
        pass


def emit(**event) -> None:
    if EVENTS:
        try:
            sys.stdout.write(json.dumps(event, ensure_ascii=False) + "\n")
            sys.stdout.flush()
        except OSError:
            pass


class Control:
    """Requests from the menu bar app: SIGUSR1 = record now, SIGUSR2 = stop recording."""
    start = False
    stop = False


def _on_usr1(signum, frame) -> None:
    Control.start = True


def _on_usr2(signum, frame) -> None:
    Control.stop = True


def tail_peak(path: Path, seconds: float = 3.0) -> float | None:
    """Loudest sample (0..1) in the last few seconds of a WAV that is still being written."""
    try:
        layout = wav_layout(path)
        if not layout:
            return None
        raw, rate, ch, offset = layout
        width = {"s16le": 2, "s32le": 4, "f32le": 4}.get(raw)
        if not width:
            return None
        size = path.stat().st_size
        n = int(rate * ch * seconds) * width
        if size - offset < n:
            return None
        with open(path, "rb") as f:
            f.seek(size - n - (size - offset) % width)
            data = f.read(n)
        a = array.array({"s16le": "h", "s32le": "i", "f32le": "f"}[raw])
        a.frombytes(data[: len(data) // width * width])
        full = {"s16le": 32768.0, "s32le": 2147483648.0, "f32le": 1.0}[raw]
        return max((abs(x) for x in a), default=0) / full
    except (OSError, ValueError, struct.error):
        return None


class Health:
    """Watches the files while recording, so a problem shows up during the call, not after it."""

    def __init__(self, rec: "Recorder"):
        self.rec = rec
        self.mic_zero_since: float | None = None
        self.sys_heard = False
        self.warned: set[str] = set()
        self.last_check = 0.0
        self.last_sound = time.time()  # last time anyone was heard on either side

    def check(self) -> None:
        now = time.time()
        if self.rec.sys_error:
            self.warn("system-error", "The other side is not being recorded (only your mic). Allow CallRec "
                                      "in System Settings > Privacy & Security > Screen & System Audio Recording.")
        if now - self.last_check < 5 or now - self.rec.started < 10:
            return
        self.last_check = now
        seg = self.rec.folder / self.rec.segments[-1][0] if self.rec.segments else None
        mic_peak = tail_peak(seg) if seg and seg.exists() else None
        # A real mic always has some noise; pure digital zero means no permission or a dead device.
        if mic_peak == 0:
            self.mic_zero_since = self.mic_zero_since or now
            if now - self.mic_zero_since > 15:
                self.warn("mic", "Your microphone is not being recorded. Check Microphone access "
                                 "for CallRec (or your terminal) in System Settings.")
        elif mic_peak:
            self.mic_zero_since = None
        if (mic_peak or 0) > 0.05:  # speech, not room noise
            self.last_sound = now
        tmps = sorted(self.rec.folder.glob(".system.wav.*.tmp"), key=lambda p: p.stat().st_mtime)
        sys_peak = tail_peak(tmps[-1], 5) if tmps else None
        if sys_peak:
            self.sys_heard = True
        if (sys_peak or 0) > 0.005:
            self.last_sound = now
        if not self.sys_heard and now - self.rec.started > 90:
            self.warn("system", "No sound from the other side in the first 90 seconds. If people are "
                                "talking, check System Audio Recording access.")

    def warn(self, key: str, message: str) -> None:
        if key in self.warned:
            return
        self.warned.add(key)
        print(f"⚠ {message}")
        emit(state="warning", message=message, folder=str(self.rec.folder))
        if not EVENTS:
            notify(message)


# ---------- recording ----------

class Recorder:
    """Mic (ffmpeg) + system audio (Core Audio tap). If the mic device disappears mid-call
    (headphones unplugged, AirPods switched), ffmpeg is restarted on the new default mic."""

    def __init__(self, folder: Path):
        self.folder = folder
        self.sys_path = folder / "system.wav"
        self.segments: list[tuple[str, float]] = []  # (file name, start offset in seconds)
        self.mic: subprocess.Popen | None = None
        self.session = None
        self.started = 0.0
        self.mic_started = 0.0
        self.next_retry = 0.0
        self.sys_error: str | None = None

    def _start_mic(self) -> None:
        name = f"mic_{len(self.segments) + 1:02d}.wav"
        offset = time.time() - self.started
        self.mic_started = time.time()
        self.mic = subprocess.Popen(
            ["ffmpeg", "-hide_banner", "-loglevel", "error", "-y", "-f", "avfoundation",
             "-i", f":{MIC}", "-ac", "1", "-ar", "48000", str(self.folder / name)],
            stdin=subprocess.PIPE, stdout=subprocess.DEVNULL, start_new_session=True,
        )
        self.segments.append((name, round(offset, 3)))
        write_meta(self.folder, mic_segments=self.segments)
        # If callrec itself dies (even SIGKILL), stop ffmpeg so the file is finalized
        # and nothing keeps recording in the background.
        watch = (f"while kill -0 {os.getpid()} 2>/dev/null && kill -0 {self.mic.pid} 2>/dev/null; "
                 f"do sleep 1; done; kill -INT {self.mic.pid} 2>/dev/null")
        subprocess.Popen(["/bin/sh", "-c", watch], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def start(self) -> None:
        from catap import record_system_audio

        self.folder.mkdir(parents=True, exist_ok=True)
        self.started = time.time()
        mic_name, out_name = audio_devices()
        write_meta(self.folder, started=dt.datetime.now().isoformat(timespec="seconds"),
                   started_at=self.started, mic=mic_name, output=out_name)
        self._start_mic()
        # If the other side can't be captured (permission, device error), keep recording the mic
        # and say so right away, instead of losing the whole recording.
        try:
            self.session = record_system_audio(str(self.sys_path), mono=True)
            self.session.start()
        except Exception as e:
            self.session = None
            self.sys_error = str(e)
            print(f"⚠ system audio failed to start: {e}", file=sys.stderr)

    def tick(self) -> None:
        if self.mic and self.mic.poll() is not None:  # mic device went away: follow the new default
            now = time.time()
            if now - self.mic_started < 5 and not self.next_retry:
                self.next_retry = now + 10  # failed right away (no permission / no device): back off
            if now >= self.next_retry:
                self.next_retry = 0.0
                self._start_mic()

    def stop(self) -> None:
        try:
            if self.session:
                self.session.stop()
        except Exception as e:  # keep going so the mic file is still saved
            print(f"⚠ system audio stop failed: {e}", file=sys.stderr)
        finally:
            if self.mic:
                stop_ffmpeg(self.mic)
        write_meta(self.folder, ended=dt.datetime.now().isoformat(timespec="seconds"),
                   duration=round(time.time() - self.started, 1))

    @property
    def silent_system(self) -> bool:
        return bool(self.sys_error) or bool(getattr(self.session, "captured_only_silence", False))


def stop_ffmpeg(proc: subprocess.Popen) -> None:
    if proc.poll() is not None:
        return
    try:
        proc.stdin.write(b"q")
        proc.stdin.close()
    except (BrokenPipeError, OSError):
        pass
    try:
        proc.wait(timeout=10)
    except subprocess.TimeoutExpired:
        proc.send_signal(signal.SIGINT)  # ffmpeg still finalizes the WAV header on SIGINT
        try:
            proc.wait(timeout=10)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait()


def import_file(src: Path) -> Path:
    """Bring in any audio or video file (phone recording, voice memo, exported meeting) as a recording
    in ~/CallRecordings, named after the file and dated when it was recorded, then transcribe it."""
    if not src.is_file():
        die(f"No such file: {src}")
    when = dt.datetime.fromtimestamp(src.stat().st_mtime)
    folder = REC_DIR / f"{when:%Y-%m-%d_%H%M}_{slug(src.stem)[:40] or 'Imported'}"
    n = 2
    while folder.exists():
        folder = folder.with_name(f"{folder.name.rsplit('~', 1)[0]}~{n}")
        n += 1
    folder.mkdir(parents=True)
    (folder / ".transcribing").write_text(str(os.getpid()))  # shows up in the Recordings window right away
    write_meta(folder, started=when.isoformat(timespec="seconds"), app="Imported", title=src.stem,
               imported_from=src.name)
    wav = folder / "call.wav"
    try:
        # One channel: we don't know which side is which in someone else's file.
        ff("-i", str(src), "-vn", "-ac", "1", "-ar", "48000", "-c:a", "pcm_s16le", str(wav))
        write_meta(folder, duration=round(probe(wav)[0], 1))
        return transcribe(wav, folder)
    except BaseException as e:
        (folder / ".transcribing").unlink(missing_ok=True)
        (folder / ".transcribe-failed").write_text(f"{type(e).__name__}: {e}"[:300], encoding="utf-8")
        raise


def new_folder(label: str | None) -> Path:
    stamp = dt.datetime.now().strftime("%Y-%m-%d_%H%M")
    folder = REC_DIR / (f"{stamp}_{slug(label)}" if label else stamp)
    n = 2
    while folder.exists():
        folder = folder.with_name(f"{folder.name.rsplit('~', 1)[0]}~{n}")
        n += 1
    return folder


def record_once(folder: Path, app: str | None, follow_meeting: bool) -> tuple[Recorder, str]:
    """Record until Enter, Ctrl+C, terminal close, or (follow_meeting) the meeting ends.
    Returns the recorder and why it stopped: enter, ctrl-c, hangup or ended."""
    rec = Recorder(folder)
    reason = "enter"
    try:
        rec.start()
        write_meta(folder, app=app)
        Control.stop = False
        emit(state="recording", app=app, folder=str(folder), started=rec.started)
        if not EVENTS:
            notify(f"Recording{' ' + app if app else ''}")
        print(f"● Recording to {folder}")
        print("  Enter or Ctrl+C stops. Closing the terminal also stops and saves.")
        seen_app, last_active = app, time.time()
        health = Health(rec)
        try:  # drop keys typed while we were waiting, so they don't stop this recording
            import termios
            termios.tcflush(sys.stdin, termios.TCIFLUSH)
        except Exception:
            pass
        while True:
            if app_gone():
                raise Hangup()
            if enter_pressed() or Control.stop:
                Control.stop = False
                break
            rec.tick()
            health.check()
            if follow_meeting:
                # Only an app that used the mic counts as a call (a browser playing a video does not).
                using_mic, active = call_apps()
                if not seen_app and using_mic:
                    seen_app = sorted(using_mic)[0]
                    write_meta(folder, app=seen_app)
                    emit(state="recording", app=seen_app, folder=str(folder), started=rec.started)
                if seen_app and seen_app in active:
                    last_active = time.time()
                elif seen_app and time.time() - last_active > END_GRACE:
                    status("")
                    print(f"\n■ {seen_app} call ended")
                    reason = "ended"
                    break
            if time.time() - health.last_sound > SILENCE_STOP:
                status("")
                print(f"\n■ Nothing heard for {SILENCE_STOP // 60} minutes")
                reason = "silence"
                break
            status(f"● {fmt_dur(time.time() - rec.started)}  {seen_app or ''}")
            time.sleep(1)
    except KeyboardInterrupt:
        reason = "ctrl-c"
    except Hangup:
        reason = "hangup"
    finally:
        # From here on, nothing may interrupt finalizing the files.
        for sig in (signal.SIGHUP, signal.SIGTERM, signal.SIGINT):
            signal.signal(sig, signal.SIG_IGN)
        if reason == "hangup":
            detach_output(folder / "callrec.log")
            print(f"[{dt.datetime.now():%H:%M:%S}] terminal closed, finalizing")
        rec.stop()
    status("")
    print(f"\n■ Stopped after {fmt_dur(time.time() - rec.started)}")
    emit(state="saving", folder=str(folder))
    return rec, reason


def finish(rec: Recorder, transcribe_mode: str, keep_tracks: bool) -> Path | None:
    """Merge tracks, then transcribe: 'inline', 'background' or 'none'."""
    folder = rec.folder
    if rec.silent_system:
        print("⚠ System audio was silent. Grant your terminal 'System Audio Recording' "
              "(System Settings > Privacy & Security > Screen & System Audio Recording) and restart it.")
    call = build_call(folder, keep_tracks)
    if not call:
        print("⚠ Nothing was recorded. Grant your terminal Microphone access.")
        emit(state="error", message="Nothing was recorded. Check Microphone access.", folder=str(folder))
        return None
    if rec.silent_system:
        emit(state="warning", message="The other side was silent. Check System Audio Recording access.",
             folder=str(folder))
    print(f"✔ Audio: {call}")
    emit(state="saved", folder=str(folder), transcribing=transcribe_mode != "none")
    if transcribe_mode == "inline":
        transcribe(call, folder)
    elif transcribe_mode == "background":
        log = open(folder / "callrec.log", "a")
        subprocess.Popen([str(SELF), "transcribe", "--notify", str(call)], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log)
        print("… Transcribing in the background (you'll get a notification)")
    return call


def mute_ranges(folder: Path) -> list[tuple[float, float]]:
    """When you muted yourself in this recording: [(from, to)] in seconds from its start."""
    meta = read_meta(folder)
    t0 = meta.get("started_at")
    if t0 is None and meta.get("started"):
        t0 = dt.datetime.fromisoformat(meta["started"]).timestamp()
    if t0 is None or not MUTE_LOG.exists():
        return []
    events = []
    for line in MUTE_LOG.read_text().splitlines():
        try:
            what, when = line.split()
            events.append((float(when), what == "on"))
        except ValueError:
            continue
    events.sort()
    ranges, muted, since = [], False, 0.0
    for when, on in events:
        rel = max(0.0, when - t0)
        if on and not muted:
            muted, since = True, rel
        elif not on and muted:
            muted = False
            if rel > since:
                ranges.append((since, rel))
    if muted:
        ranges.append((since, 1e7))  # still muted when the recording ended
    return [(a, b) for a, b in ranges if b > 0]


def mute_filter(ranges: list[tuple[float, float]]) -> str:
    if not ranges:
        return ""
    cond = "+".join(f"between(t,{a:.2f},{b:.2f})" for a, b in ranges)
    return f"volume=0:enable='{cond}',"


def build_call(folder: Path, keep_tracks: bool = False) -> Path | None:
    """mic segments + system.wav → call.wav (left = you, right = the other side)."""
    mic_path, sys_path, call = folder / "mic.wav", folder / "system.wav", folder / "call.wav"
    segments = [(folder / n, off) for n, off in read_meta(folder).get("mic_segments", [])
                if has_audio(folder / n)]
    if segments:
        if len(segments) == 1 and segments[0][1] < 0.5:
            segments[0][0].replace(mic_path)
        else:
            ins, graph = [], []
            for i, (p, off) in enumerate(segments):
                ins += ["-i", str(p)]
                ms = int(off * 1000)
                graph.append(f"[{i}:a]adelay={ms}:all=1[s{i}]")
            graph.append("".join(f"[s{i}]" for i in range(len(segments)))
                         + f"amix=inputs={len(segments)}:normalize=0:duration=longest[m]")
            ff(*ins, "-filter_complex", ";".join(graph), "-map", "[m]", "-ac", "1", str(mic_path))
            for p, _ in segments:
                p.unlink(missing_ok=True)
    mic_ok, sys_ok = has_audio(mic_path), has_audio(sys_path)
    if not (mic_ok or sys_ok):
        return None
    muted = mute_ranges(folder)
    if muted:
        write_meta(folder, muted=[[round(a, 1), round(min(b, 1e6), 1)] for a, b in muted])
    silence_me = mute_filter(muted)  # your mic is silent in the recording while you were muted
    if mic_ok != sys_ok:
        extra = ["-af", silence_me.rstrip(",")] if mic_ok and silence_me else []
        ff("-i", str(mic_path if mic_ok else sys_path), *extra, "-ac", "1", "-ar", "16000", "-c:a", "pcm_s16le", str(call))
    else:
        end = max(probe(mic_path)[0], probe(sys_path)[0])
        chain = f"aresample=16000,pan=mono|c0=c0,apad,atrim=end={end:.3f}"
        graph = f"[0:a]{silence_me}{chain}[l];[1:a]{chain}[r];[l][r]join=inputs=2:channel_layout=stereo[a]"
        ff("-i", str(mic_path), "-i", str(sys_path), "-filter_complex", graph, "-map", "[a]",
           "-c:a", "pcm_s16le", str(call))
    if not keep_tracks:
        mic_path.unlink(missing_ok=True)
        sys_path.unlink(missing_ok=True)
    return call


def record_now(name: str | None, transcribe_after: bool, keep_tracks: bool, open_after: bool) -> None:
    need("ffmpeg")
    warn_orphans()
    signal.signal(signal.SIGHUP, _on_hangup)
    signal.signal(signal.SIGTERM, _on_hangup)
    app = meeting_app()
    rec, reason = record_once(new_folder(name or app), app, follow_meeting=True)
    hung_up = reason == "hangup"
    mode = "none" if not transcribe_after else ("background" if hung_up else "inline")
    finish(rec, mode, keep_tracks)
    if open_after and not hung_up:
        subprocess.run(["open", str(rec.folder)])


def auto(transcribe_after: bool, keep_tracks: bool) -> None:
    """Wait for meetings and record each one, for as long as this runs.
    The menu bar app runs this too and steers it with SIGUSR1/SIGUSR2 and ~/.callrec/auto-off."""
    need("ffmpeg")
    recover_leftovers()
    compact_old()
    resume_unfinished()
    signal.signal(signal.SIGHUP, _on_hangup)
    signal.signal(signal.SIGTERM, _on_hangup)
    signal.signal(signal.SIGUSR1, _on_usr1)
    signal.signal(signal.SIGUSR2, _on_usr2)
    if not EVENTS:
        print("callrec is on. Every call (Zoom, Meet, Slack, Teams, FaceTime, WhatsApp...) is recorded "
              "and transcribed automatically.")
        print("Ctrl+C to quit. Recordings go to", REC_DIR)
    paused = False  # stopped by hand: don't restart until that meeting ends
    try:
        while True:
            state, app, since = None, None, None
            while True:
                if app_gone():
                    raise Hangup()
                if Control.start:
                    Control.start = False
                    app = meeting_app()
                    break
                auto_on = not AUTO_OFF.exists()
                if paused and not meeting_app(include_output=True):
                    paused = False
                want = "paused" if paused else ("waiting" if auto_on else "idle")
                if want != state:
                    state = want
                    emit(state=want)
                status({"paused": "⏸ Waiting for the current meeting to end",
                        "idle": "Auto recording is off"}.get(want, f"⏳ Waiting for a meeting  ({dt.datetime.now():%H:%M})"))
                if auto_on and not paused:
                    app = meeting_app()
                    if app and since and time.time() - since >= 3:
                        break
                    since = (since or time.time()) if app else None
                time.sleep(1)
            status("")
            print()
            rec, reason = record_once(new_folder(app), app, follow_meeting=True)
            finish(rec, "background" if transcribe_after else "none", keep_tracks)
            if reason in ("hangup", "ctrl-c"):
                print("callrec is off.")
                return
            for sig in (signal.SIGHUP, signal.SIGTERM):
                signal.signal(sig, _on_hangup)
            signal.signal(signal.SIGINT, signal.default_int_handler)
            paused = reason == "enter"
    except (KeyboardInterrupt, Hangup):
        status("")
        emit(state="off")
        try:
            print("\nBye.")
        except OSError:  # the app closed our output pipe; nothing left to tell
            pass


def selftest() -> bool:
    """Record a few seconds while playing a sound, and check both sides come through.
    Run once at setup so the permission prompts appear now, not during a call."""
    need("ffmpeg")
    folder = HOME / ".callrec/selftest"
    shutil.rmtree(folder, ignore_errors=True)
    rec = Recorder(folder)
    try:
        rec.start()
        time.sleep(1.5)
        for _ in range(2):
            subprocess.run(["afplay", "/System/Library/Sounds/Glass.aiff"])
        time.sleep(1.5)
    finally:
        rec.stop()
    segs = [folder / n for n, _ in rec.segments if (folder / n).exists()]
    mic_ok = any((tail_peak(p, 2) or 0) > 0 for p in segs)
    sys_ok = has_audio(rec.sys_path) and not rec.silent_system
    shutil.rmtree(folder, ignore_errors=True)
    print(f"{'✔' if mic_ok else '✖'} microphone")
    print(f"{'✔' if sys_ok else '✖'} other side (system audio)")
    emit(state="selftest", mic=mic_ok, system=sys_ok)
    return mic_ok and sys_ok


def busy(folder: Path) -> bool:
    """Is a transcription of this folder running right now? (A marker left by a crash or shutdown is not.)"""
    marker = folder / ".transcribing"
    if not marker.exists():
        return False
    try:
        os.kill(int(marker.read_text().strip()), 0)
        return True
    except (ValueError, OSError):
        # No live process behind it. Old markers have no PID: trust them only while fresh.
        if not marker.read_text().strip() and time.time() - marker.stat().st_mtime < 6 * 3600:
            return True
        marker.unlink(missing_ok=True)
        return False


def resume_unfinished() -> None:
    """After a crash, shutdown or update in the middle of transcribing: finish the job in the background.
    (A cut-off compression needs nothing extra: the full call.wav is kept and compact_old redoes it.)"""
    if not REC_DIR.exists():
        return
    todo = []
    for folder in sorted(REC_DIR.iterdir()):
        src = call_file(folder) if folder.is_dir() else None
        if not src or (folder / "call.transcript.md").exists() or busy(folder):
            continue
        meta = read_meta(folder)
        if (folder / ".transcribe-failed").exists() and meta.get("auto_retries", 0) >= 1:
            continue  # a real failure: wait for "Try again" instead of retrying on every start
        write_meta(folder, auto_retries=meta.get("auto_retries", 0) + 1)
        todo.append(src)
    if todo:
        print(f"… Finishing {len(todo)} transcription(s) that were cut off")
        log = open(todo[0].parent / "callrec.log", "a")
        subprocess.Popen([str(SELF), "transcribe", "--notify", *map(str, todo)], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=log, stderr=log)


def compact_old() -> None:
    """Older recordings that are already transcribed: WAV → m4a, to save disk space."""
    if not REC_DIR.exists():
        return
    for folder in REC_DIR.iterdir():
        wav = folder / "call.wav"
        if wav.exists() and (folder / "call.transcript.md").exists() and not busy(folder):
            try:
                if compress(wav).suffix == ".m4a":
                    write_meta(folder, audio="call.m4a")
            except Exception as e:
                print(f"⚠ could not compress {folder.name}: {e}")


def recover_leftovers() -> None:
    """A recording cut off by a crash or restart is finished and transcribed on the next start."""
    if not REC_DIR.exists():
        return
    for folder in sorted(REC_DIR.iterdir()):
        if not folder.is_dir() or has_call(folder):
            continue
        if not (list(folder.glob("mic*.wav")) or list(folder.glob(".system.wav.*.tmp")) or (folder / "system.wav").exists()):
            continue
        try:
            recover([folder], transcribe_after=False)
            call = folder / "call.wav"
            if call.exists():
                emit(state="recovered", folder=str(folder))
                subprocess.Popen([str(SELF), "transcribe", "--notify", str(call)], start_new_session=True,
                                 stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except Exception as e:  # never block startup on an old folder
            print(f"⚠ could not recover {folder.name}: {e}")


