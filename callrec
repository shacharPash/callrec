def app_gone() -> bool:
    """True if we were started by the menu bar app and it is no longer running."""
    if not APP_PID:
        return False
    try:
        os.kill(APP_PID, 0)
        return False
    except ProcessLookupError:
        return True
    except PermissionError:
        return False

