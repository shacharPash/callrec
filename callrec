SPEAKER_RE = re.compile(r"^\s*\(speaker (\d|\?)\)\s*")
TIME_RE = re.compile(r"(\d{2}):(\d{2}):(\d{2})[,.]\d{3}\s*-->")
SPAN_RE = re.compile(r"(\d\d):(\d\d):(\d\d)[,.](\d\d\d)\s*-->\s*(\d\d):(\d\d):(\d\d)[,.](\d\d\d)")


def channel_levels(wav: Path) -> tuple[list[float], list[float]] | None:
    """Loudness of the left (you) and right (them) channel every 0.1 s, to settle lines Whisper marks "?"."""
    try:
        import wave as wavemod
        with wavemod.open(str(wav)) as w:
            if w.getnchannels() != 2:
                return None
            step = w.getframerate() // 10
            left: list[float] = []
            right: list[float] = []
            while True:
                a = array.array("h")
                a.frombytes(w.readframes(step))
                if len(a) < step * 2:
                    break
                l, r = a[0::32], a[1::32]  # every 16th frame is plenty to tell which side is louder
                left.append(sum(x * x for x in l))
                right.append(sum(x * x for x in r))
        return left, right
    except Exception:
        return None


def speaker_turns(wav: Path, channel: int = 1) -> list[tuple[float, float, int]]:
    """Who on the other side (right channel; or the only channel of an imported file) talks when:
    [(start, end, speaker 1..N)].
    Empty when there is only one voice there, or anything fails (the transcript then says "the other side")."""
    if not (SPK_SEG.exists() and SPK_EMB.exists()):
        return []
    mono = wav.with_name(f"{wav.stem}.them.wav")
    try:
        import numpy as np
        import sherpa_onnx as so
        import wave as wavemod
        ff("-i", str(wav), "-af", f"pan=mono|c0=c{channel}", "-ar", "16000", "-c:a", "pcm_s16le", str(mono))
        with wavemod.open(str(mono)) as w:
            audio = np.frombuffer(w.readframes(w.getnframes()), dtype=np.int16).astype(np.float32) / 32768
        cfg = so.OfflineSpeakerDiarizationConfig(
            segmentation=so.OfflineSpeakerSegmentationModelConfig(
                pyannote=so.OfflineSpeakerSegmentationPyannoteModelConfig(model=str(SPK_SEG)), num_threads=4),
            embedding=so.SpeakerEmbeddingExtractorConfig(model=str(SPK_EMB), num_threads=4),
            clustering=so.FastClusteringConfig(num_clusters=-1, threshold=SPK_THRESHOLD),
            min_duration_on=0.3, min_duration_off=0.5)
        segs = [(s.start, s.end, s.speaker) for s in so.OfflineSpeakerDiarization(cfg).process(audio).sort_by_start_time()]
    except Exception as e:
        print(f"⚠ Speaker separation skipped: {e}")
        return []
    finally:
        mono.unlink(missing_ok=True)
    total: dict[int, float] = {}
    for a, b, k in segs:
        total[k] = total.get(k, 0) + b - a
    speech = sum(total.values())
    # A real speaker talks for a while; tiny clusters are the same voice heard differently (laugh, codec).
    real = {k for k, t in total.items() if t >= max(15.0, 0.05 * speech)}
    if len(real) < 2:
        return []
    fixed = []
    for i, (a, b, k) in enumerate(segs):
        if k not in real:  # fold into the nearest segment of a real speaker
            k = min((x for x in segs if x[2] in real), key=lambda x: min(abs(x[0] - b), abs(a - x[1])))[2]
        fixed.append((a, b, k))
    order = {}
    for _, _, k in fixed:
        order.setdefault(k, len(order) + 1)  # Speaker 1 = first to talk
    return [(a, b, order[k]) for a, b, k in fixed]


MODEL_NAMES = {"he": "ivrit.ai whisper-large-v3-turbo", "en": "Whisper large-v3-turbo"}


def model_for(lang: str) -> Path:
    return MODEL_HE if lang == "he" or not MODEL_EN.exists() else MODEL_EN


def detect_clip(wav: Path, start: float, length: float = 30) -> tuple[str, float]:
    """Whisper language id on one excerpt: (language, probability)."""
    clip = wav.with_name(f"{wav.stem}.lang{int(start)}.wav")
    ff("-ss", f"{start:.1f}", "-t", f"{length:.1f}", "-i", str(wav), "-ac", "1", str(clip))
    try:
        out = subprocess.run([whisper_bin(), "-m", str(model_for("en")), "-l", "auto", "-dl", "-f", str(clip)],
                             capture_output=True, text=True)
    finally:
        clip.unlink(missing_ok=True)
    m = re.search(r"auto-detected language:\s*(\w+)\s*\(p\s*=\s*([\d.]+)", out.stderr + out.stdout)
    return (m.group(1), float(m.group(2))) if m else ("he", 0.0)


def loud_enough(wav: Path, start: float, length: float) -> bool:
    """Is anyone talking in this stretch? (cheap RMS on the 16 kHz WAV)."""
    layout = wav_layout(wav)
    if not layout:
        return True
    _, rate, ch, offset = layout
    with open(wav, "rb") as f:
        f.seek(offset + int(start * rate) * ch * 2)
        data = f.read(int(length * rate) * ch * 2)
    a = array.array("h")
    a.frombytes(data[: len(data) // 2 * 2])
    if not a:
        return False
    # Loudest channel: on headphones the other side is only on the right.
    def rms(c: int) -> float:
        xs = a[c::ch * 8]
        return (sum(x * x for x in xs) / max(1, len(xs))) ** 0.5 / 32768
    return max(rms(c) for c in range(ch)) > 0.003


def language_runs(wav: Path, duration: float) -> list[tuple[float, float, str]]:
    """Split a call into stretches of Hebrew and English: [(start, end, lang)].
    One-language calls (the usual case) come back as a single stretch."""
    if LANG != "auto":
        return [(0.0, duration, LANG)]
    if duration < 90:
        lang, _ = detect_clip(wav, min(60.0, duration * 0.1))
        return [(0.0, duration, lang if lang in ("he", "en") else "he")]
    # Check every 30s (every minute on calls over 20 min). A switch needs 2 checks in a row.
    step = 30.0 if duration <= 1200 else 60.0
    starts = [i * step for i in range(int(duration // step) + 1) if i * step < duration - 5]
    votes: list[tuple[str | None, float]] = []
    for st in starts:
        length = min(30.0, duration - st)
        votes.append(detect_clip(wav, st, length) if loud_enough(wav, st, length) else (None, 0.0))
    counted = [l for l, _ in votes if l in ("he", "en")]
    dominant = max(("he", "en"), key=counted.count) if counted else "he"
    # Switch away from the main language only when Whisper is sure, and for at least 2 checks.
    labels = [l if l in ("he", "en") and (l == dominant or p >= 0.8) else None for l, p in votes]
    for i, l in enumerate(labels):
        if l is None:
            labels[i] = labels[i - 1] if i and labels[i - 1] else dominant
    i = 0
    while i < len(labels):
        j = i
        while j < len(labels) and labels[j] == labels[i]:
            j += 1
        if labels[i] != dominant and j - i < 2:
            for k in range(i, j):
                labels[k] = dominant
        i = j
    runs: list[tuple[float, float, str]] = []
    for st, l in zip(starts, labels):
        if runs and runs[-1][2] == l:
            runs[-1] = (runs[-1][0], min(duration, st + step), l)
        else:
            runs.append((st, min(duration, st + step), l))
    runs[-1] = (runs[-1][0], duration, runs[-1][2])
    return runs


SRT_TIME = re.compile(r"(\d\d):(\d\d):(\d\d),(\d\d\d)")


def shift_srt(srt: str, offset: float) -> list[str]:
    """SRT blocks with their timestamps moved by offset seconds (index lines dropped)."""
    def move(m: re.Match) -> str:
        t = int(m[1]) * 3600 + int(m[2]) * 60 + int(m[3]) + int(m[4]) / 1000 + offset
        ms = int(round(t * 1000))
        return f"{ms // 3600000:02d}:{ms // 60000 % 60:02d}:{ms // 1000 % 60:02d},{ms % 1000:03d}"
    blocks = []
    for block in re.split(r"\n\s*\n", srt.strip()):
        lines = [l for l in block.splitlines() if l.strip()]
        ts = next((i for i, l in enumerate(lines) if "-->" in l), None)
        if ts is not None:
            blocks.append("\n".join([SRT_TIME.sub(move, lines[ts]), *lines[ts + 1:]]))
    return blocks


def whisper(wav: Path, lang: str, base: Path, stereo: bool) -> Path:
    model = model_for(lang)
    if not model.exists():
        die(f"Model not found at {model}. Run the CallRec installer (see README) or setup.sh.")
    cmd = [whisper_bin(), "-m", str(model), "-l", lang, "-f", str(wav), "-osrt", "-of", str(base), "-np", "-pp"]
    if stereo:
        cmd.append("-di")  # stereo diarization: left = you, right = the other side
        # Short lines (split at word boundaries), so each one can be given to the right speaker.
        cmd += ["-ml", "60", "-sow"]
    if VAD_MODEL.exists():
        cmd += ["--vad", "-vm", str(VAD_MODEL)]
    run(cmd, stdout=subprocess.DEVNULL)
    return Path(f"{base}.srt")


def compress(wav: Path) -> Path:
    """call.wav → call.m4a (about 30 MB per hour instead of 230 MB). The WAV is removed only
    after the m4a is checked to be complete."""
    m4a = wav.with_suffix(".m4a")
    try:
        ff("-i", str(wav), "-c:a", "aac", "-b:a", "64k", "-movflags", "+faststart", str(m4a))
    except BaseException as e:
        # Keep the full WAV; a half-written m4a must not be mistaken for the recording.
        m4a.unlink(missing_ok=True)
        print(f"⚠ Could not compress, keeping {wav.name}: {e}")
        if not isinstance(e, Exception):
            raise
        return wav
    if abs(probe(m4a)[0] - probe(wav)[0]) < 1.0:
        wav.unlink()
        return m4a
    m4a.unlink(missing_ok=True)
    return wav


def transcribe(src: Path, folder: Path | None = None, notify_done: bool = False) -> Path:
    need("ffmpeg")
    folder = folder or src.parent
    duration, channels = probe(src)
    stereo = channels == 2
    marker = folder / ".transcribing"
    marker.write_text(str(os.getpid()))  # who is working on it, so a restart can tell if it was cut off
    wav = folder / f".{src.stem}.16k.wav"
    base = folder / f"{src.stem}.transcript"
    turns: list[tuple[float, float, int]] = []
    levels = None
    try:
        ff("-i", str(src), "-ac", "2" if stereo else "1", "-ar", "16000", "-c:a", "pcm_s16le", str(wav))
        runs = language_runs(wav, duration)
        langs = sorted({l for _, _, l in runs}, key=lambda l: -sum(e - s for s, e, x in runs if x == l))
        lang = langs[0]
        names = " + ".join(MODEL_NAMES.get(l, l) for l in langs)
        print(f"… Transcribing ({'+'.join(langs)}, {names}, local)")
        if len(runs) == 1:
            whisper(wav, lang, base, stereo)
        else:
            blocks: list[str] = []
            for i, (st, en, l) in enumerate(runs):
                part = folder / f".part{i}.wav"
                part_base = folder / f".part{i}"
                ff("-ss", f"{st:.2f}", "-t", f"{en - st:.2f}", "-i", str(wav), "-c:a", "pcm_s16le", str(part))
                try:
                    out = whisper(part, l, part_base, stereo)
                    blocks += shift_srt(out.read_text(encoding="utf-8", errors="replace").replace("\ufffd", ""), st)
                finally:
                    part.unlink(missing_ok=True)
                    Path(f"{part_base}.srt").unlink(missing_ok=True)
            Path(f"{base}.srt").write_text(
                "\n\n".join(f"{n + 1}\n{b}" for n, b in enumerate(blocks)) + "\n", encoding="utf-8")
        if SPEAKERS:
            print("… Telling apart the voices" + (" on the other side" if stereo else ""))
            turns = speaker_turns(wav, 1 if stereo else 0)
        levels = channel_levels(wav) if stereo else None
    finally:
        wav.unlink(missing_ok=True)
        marker.unlink(missing_ok=True)

    if src.name == "call.wav":
        src = compress(src)
    srt = Path(f"{base}.srt")
    md = Path(f"{base}.md")
    meta = {}
    if src.stem == "call":
        meta = write_meta(folder, language="+".join(langs), model=names, audio=src.name,
                          language_runs=[[round(s, 1), round(e, 1), l] for s, e, l in runs] if len(runs) > 1 else None,
                          speakers=len({k for _, _, k in turns}) or None)
    body = srt_to_markdown(srt.read_text(encoding="utf-8", errors="replace").replace("\ufffd", ""), stereo, lang, turns, levels)
    md.write_text(header(folder, src, duration, "+".join(langs), meta) + body, encoding="utf-8")
    print(f"✔ Transcript: {md}")
    if notify_done:
        notify(f"Transcript ready: {folder.name}")
    return md


def header(folder: Path, src: Path, duration: float, lang: str, meta: dict) -> str:
    he = lang.startswith("he")
    started = meta.get("started", "")
    when = started.replace("T", " ")[:16] if started else ""
    rows = [
        ("תאריך" if he else "Date", when),
        ("משך" if he else "Duration", fmt_dur(duration)),
        ("אפליקציה" if he else "App", meta.get("app") or ""),
        ("שפה" if he else "Language", lang),
        ("מודל" if he else "Model", meta.get("model") or ""),
        ("מיקרופון" if he else "Microphone", meta.get("mic") or ""),
        ("שמע" if he else "Audio out", meta.get("output") or ""),
        ("קובץ שמע" if he else "Audio", src.name),
    ]
    lines = [f"# {meta.get('title') or folder.name}", ""] + [f"- **{k}**: {v}" for k, v in rows if v] + ["", "---", ""]
    return "\n".join(lines) + "\n"


# Whisper invents these on silence (Knesset / YouTube training data). Only phrases nobody says
# in a real call: VAD already skips silence, so this is a last safety net, not a word filter.
HALLUCINATIONS = ("תודה רבה, אדוני היושב-ראש", "אדוני היושב-ראש", "חברי הכנסת",
                  "תודה שצפיתם", "Thanks for watching", "Subtitles by")


def srt_to_markdown(srt: str, stereo: bool, lang: str = "he",
                    turns: list[tuple[float, float, int]] | None = None,
                    levels: tuple[list[float], list[float]] | None = None) -> str:
    me, them = LABELS.get(lang, LABELS["en"])
    me, them = os.environ.get("CALLREC_ME", me), os.environ.get("CALLREC_THEM", them)
    labels = {"0": me, "1": them, "?": "?"}
    speaker_word = "דובר" if lang == "he" else "Speaker"

    def seconds(span: re.Match) -> tuple[float, float]:
        g = [int(x) for x in span.groups()]
        return (g[0] * 3600 + g[1] * 60 + g[2] + g[3] / 1000, g[4] * 3600 + g[5] * 60 + g[6] + g[7] / 1000)

    def who(span: re.Match | None) -> str | None:
        """The other-side speaker who talks most during this line (or the nearest one, in a gap)."""
        if not (turns and span):
            return None
        a, b = seconds(span)
        best: dict[int, float] = {}
        for s, e, k in turns:
            if e > a and s < b:
                best[k] = best.get(k, 0) + min(e, b) - max(s, a)
        if not best:
            near = min(turns, key=lambda t: min(abs(t[0] - b), abs(a - t[1])))
            if min(abs(near[0] - b), abs(a - near[1])) > 5:
                return None
            best = {near[2]: 1.0}
        return f"{speaker_word} {max(best, key=best.get)}"

    def louder(span: re.Match | None) -> str:
        """Both of you talked at once ("?"): give the line to the louder side."""
        if not (levels and span):
            return "?"
        a, b = seconds(span)
        i, j = int(a * 10), max(int(b * 10), int(a * 10) + 1)
        left, right = sum(levels[0][i:j]), sum(levels[1][i:j])
        return "0" if left >= right else "1"

    parsed = []  # (timestamp, speaker id, text)
    for block in re.split(r"\n\s*\n", srt.strip()):
        lines = [l for l in block.splitlines() if l.strip()]
        ts_i = next((i for i, l in enumerate(lines) if "-->" in l), None)
        if ts_i is None:
            continue
        m = TIME_RE.search(lines[ts_i])
        ts = f"{m.group(1)}:{m.group(2)}:{m.group(3)}" if m else ""
        text = " ".join(lines[ts_i + 1:]).strip()
        sm = SPEAKER_RE.match(text)
        spk = sm.group(1) if sm else ""
        text = text[sm.end():].strip() if sm else text
        if text:
            span = SPAN_RE.search(lines[ts_i])
            if spk == "?":
                spk = louder(span)
            name = who(span) if spk == "1" or not stereo else None
            parsed.append((ts, name or spk, text))

    def junk(text: str) -> bool:
        key = text.strip(" .,!?")
        return len(key.split()) <= 8 and any(key.startswith(h) for h in HALLUCINATIONS)

    paragraphs: list[tuple[str, str, list[str]]] = []
    for ts, spk, text in parsed:
        if junk(text):
            continue
        speaker = labels.get(spk, spk) if spk else ""
        if paragraphs and paragraphs[-1][0] == speaker and (stereo or len(paragraphs[-1][2]) < 6):
            paragraphs[-1][2].append(text)
        else:
            paragraphs.append((speaker, ts, [text]))

    out = [f"**{s}** ({ts}): {' '.join(t)}" if s else f"{' '.join(t)} ({ts})" for s, ts, t in paragraphs]
    return "\n\n".join(out) + "\n"


# ---------- list ----------

def list_recordings() -> None:
    if not REC_DIR.exists():
        print("No recordings yet.")
        return
    folders = sorted((p for p in REC_DIR.iterdir() if p.is_dir()), reverse=True)
    if not folders:
        print("No recordings yet.")
        return
    for folder in folders:
        meta = read_meta(folder)
        md = folder / "call.transcript.md"
        if md.exists():
            state = "✔"
        elif (folder / ".transcribing").exists():
            state = "…"
        elif has_call(folder):
            state = "♪"
        else:
            state = "✖"
        dur = meta.get("duration")
        if not dur and call_file(folder):
            dur = probe(call_file(folder))[0]
        preview = ""
        if md.exists():
            text = md.read_text(encoding="utf-8", errors="replace").replace("\ufffd", "").split("---", 1)[-1]
            text = re.sub(r"\*\*(.+?)\*\* \(\d\d:\d\d:\d\d\):", r"\1:", text)
            preview = re.sub(r"\(\d\d:\d\d:\d\d\)|\s+", " ", text).strip()[:70]
        print(f"{state} {folder.name:<32} {fmt_dur(dur or 0):>8}  {meta.get('language', ''):<3} {preview}")
    print(f"\n✔ transcribed   … transcribing   ♪ audio only   ✖ incomplete (run 'callrec recover')\n{REC_DIR}")


# ---------- doctor ----------

def doctor() -> None:
    ok = True
    for tool in ("ffmpeg", "ffprobe"):
        found = shutil.which(tool)
        print(f"{'✔' if found else '✖'} {tool}")
        ok &= bool(found)
    w = next((n for n in ("whisper-cli", "whisper-cpp") if shutil.which(n)), None)
    print(f"{'✔' if w else '✖'} whisper.cpp ({w or 'missing'})")
    ok &= bool(w)
    for label, model, required in (("Hebrew (ivrit.ai)", MODEL_HE, True), ("English", MODEL_EN, False)):
        print(f"{'✔' if model.exists() else '✖'} {label} model {model}")
        ok &= model.exists() or not required
    try:
        import catap  # noqa: F401
        print("✔ catap")
        app = meeting_app()
        print(f"  meeting detection works ({'now: ' + app if app else 'no meeting right now'})")
    except Exception as e:  # pragma: no cover
        print(f"✖ catap ({e})")
        ok = False
    print("\nMic devices (callrec uses the system default; set CALLREC_MIC to override):", flush=True)
    listing = subprocess.run(["ffmpeg", "-hide_banner", "-f", "avfoundation", "-list_devices", "true", "-i", ""],
                             capture_output=True, text=True).stderr
    audio = listing.split("audio devices:", 1)[-1] if "audio devices:" in listing else ""
    for line in audio.splitlines():
        m = re.search(r"\]\s*(\[\d+\].*)$", line)
        if m:
            print(f"  {m.group(1)}")
    if recorder_pids():
        print("\n⚠ A leftover mic recorder is running. Run 'callrec recover'.")
        ok = False
    sys.exit(0 if ok else 1)


# ---------- CLI ----------

def main() -> None:
    argv = sys.argv[1:]
    cmd = argv[0] if argv else ""
    if cmd == "import":
        files = [a for a in argv[1:] if not a.startswith("--")]
        if not files:
            die("Usage: callrec import FILE [FILE ...]")
        for f in files:
            import_file(Path(f).expanduser().resolve())
        return
    if cmd == "transcribe":
        files = [a for a in argv[1:] if not a.startswith("--")]
        if not files:
            die("Usage: callrec transcribe FILE [FILE ...]")
        for f in files:
            src = Path(f).expanduser().resolve()
            failed = src.parent / ".transcribe-failed"
            failed.unlink(missing_ok=True)
            try:
                transcribe(src, notify_done="--notify" in argv)
            except BaseException as e:
                # Leave a note for the Recordings window, so a failure is never silent.
                failed.write_text(f"{type(e).__name__}: {e}"[:300], encoding="utf-8")
                raise
        return
    if cmd == "recover":
        rest = [a for a in argv[1:] if not a.startswith("--")]
        recover([Path(f).expanduser().resolve() for f in rest], "--no-transcribe" not in argv)
        return
    if cmd == "doctor":
        doctor()
        return
    if cmd == "selftest":
        sys.exit(0 if selftest() else 1)
    if cmd == "list":
        list_recordings()
        return

    p = argparse.ArgumentParser(prog="callrec", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("name", nargs="?", help="record right now with this label (omit for auto mode)")
    p.add_argument("--no-transcribe", action="store_true", help="only record")
    p.add_argument("--keep-tracks", action="store_true", help="keep separate mic.wav and system.wav")
    p.add_argument("--open", action="store_true", help="open the folder when done")
    a = p.parse_args(argv)
    if a.name:
        record_now(a.name, not a.no_transcribe, a.keep_tracks, a.open)
    else:
        auto(not a.no_transcribe, a.keep_tracks)


if __name__ == "__main__":
    main()
