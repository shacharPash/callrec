def recorder_pids(folder: Path | None = None) -> list[int]:
    """ffmpeg processes that callrec started (optionally only those writing into folder)."""
    pattern = f"ffmpeg .*-f avfoundation .*{re.escape(str(folder or REC_DIR))}"
    out = subprocess.run(["pgrep", "-f", pattern], capture_output=True, text=True).stdout
    return [int(p) for p in out.split()]


def warn_orphans() -> None:
    pids = recorder_pids()
    if pids:
        print(f"⚠ An older callrec mic recorder is still running (pid {', '.join(map(str, pids))}). "
              "Run 'callrec recover' to stop and save it.")


def stop_pids(pids: list[int]) -> None:
    for pid in pids:
        try:
            os.kill(pid, signal.SIGINT)
        except ProcessLookupError:
            continue
        for _ in range(40):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                break
            time.sleep(0.25)


def wav_layout(path: Path) -> tuple[str, int, int, int] | None:
    """(ffmpeg raw format, rate, channels, data offset) from a WAV header whose sizes were never filled in."""
    with open(path, "rb") as f:
        head = f.read(4096)
    if head[:4] != b"RIFF" or head[8:12] != b"WAVE":
        return None
    pos, fmt = 12, None
    while pos + 8 <= len(head):
        cid, size = head[pos:pos + 4], struct.unpack("<I", head[pos + 4:pos + 8])[0]
        if cid == b"fmt ":
            tag, ch, rate = struct.unpack("<HHI", head[pos + 8:pos + 16])
            bits = struct.unpack("<H", head[pos + 22:pos + 24])[0]
            if tag == 0xFFFE:  # WAVE_FORMAT_EXTENSIBLE: real tag is in the subformat GUID
                tag = struct.unpack("<H", head[pos + 32:pos + 34])[0]
            raw = {(1, 16): "s16le", (1, 24): "s24le", (1, 32): "s32le", (3, 32): "f32le"}.get((tag, bits))
            fmt = (raw, rate, ch) if raw else None
        elif cid == b"data":
            return (*fmt, pos + 8) if fmt else None
        pos += 8 + size + (size & 1)
    return None


def repair_wav(src: Path, dst: Path) -> bool:
    layout = wav_layout(src)
    if not layout:
        return False
    raw, rate, ch, offset = layout
    ff("-f", raw, "-ar", str(rate), "-ac", str(ch), "-skip_initial_bytes", str(offset),
       "-i", str(src), "-c:a", "pcm_s16le", str(dst))
    return has_audio(dst)


def wav_ok(path: Path) -> bool:
    with open(path, "rb") as f:
        return f.read(8)[4:8] != b"\xff\xff\xff\xff"


def recover(folders: list[Path], transcribe_after: bool) -> None:
    need("ffmpeg")
    if not folders:
        folders = sorted(p for p in REC_DIR.iterdir() if p.is_dir() and not has_call(p)) \
            if REC_DIR.exists() else []
        if not folders:
            print("Nothing to recover.")
            return
    for folder in folders:
        print(f"→ {folder}")
        pids = recorder_pids(folder)
        if pids:
            print(f"  stopping leftover mic recorder (pid {', '.join(map(str, pids))})")
            stop_pids(pids)
        sys_path = folder / "system.wav"
        if not has_audio(sys_path):
            # catap writes to a hidden temp file and renames it on a clean stop.
            tmps = sorted(folder.glob(".system.wav.*.tmp"), key=lambda p: p.stat().st_size)
            if tmps and repair_wav(tmps[-1], sys_path):
                print(f"  recovered system audio from {tmps[-1].name}")
                for t in tmps:
                    t.unlink()
        for mic in [folder / "mic.wav", *folder.glob("mic_*.wav")]:
            if has_audio(mic) and not wav_ok(mic):
                fixed = folder / f".{mic.stem}.fixed.wav"
                if repair_wav(mic, fixed):
                    fixed.replace(mic)
                    print(f"  repaired {mic.name}")
        call = build_call(folder)
        if not call:
            print("  nothing recorded here")
            continue
        print(f"✔ Audio: {call}")
        if transcribe_after:
            transcribe(call, folder)


